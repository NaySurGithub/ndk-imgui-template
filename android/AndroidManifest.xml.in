<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by CMake from android/AndroidManifest.xml.in; edit the template. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@APP_ID@"
    android:versionCode="@APP_VERSION_CODE@"
    android:versionName="@PROJECT_VERSION@">

    <uses-sdk
        android:minSdkVersion="@APP_ANDROID_MIN_SDK@"
        android:targetSdkVersion="@APP_ANDROID_TARGET_SDK@" />

    <!-- hasCode="false": no Java at all, the activity is the framework's NativeActivity. -->
    <application
        android:label="@APP_NAME@"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:allowBackup="false"
        android:theme="@style/AppTheme">
        <!-- configChanges: rotation and the like resize the window instead of restarting the
             activity, so the GL context and the app's state survive. adjustNothing: the
             keyboard covers the window, which moves its content out of the way itself (the
             safe area includes the keyboard). -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|density|uiMode"
            android:windowSoftInputMode="adjustNothing">
            <meta-data android:name="android.app.lib_name" android:value="@APP_LIB_NAME@" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
